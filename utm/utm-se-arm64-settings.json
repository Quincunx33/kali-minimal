{
  "format": "UTM SE settings manifest",
  "importableBundle": false,
  "note": "Use these values in UTM SE. Attach the ISO manually because UTM .utm bundles contain host-specific bookmarks and configuration metadata.",
  "name": "Kali Minimal ARM64 Terminal",
  "backend": "qemu",
  "architecture": "aarch64",
  "machine": "virt",
  "memoryMiB": 768,
  "cpuCores": 2,
  "hypervisor": false,
  "uefi": true,
  "display": "none or text/serial console",
  "serial": {
    "hardware": "pl011",
    "interface": "ptty"
  },
  "drive": {
    "removable": true,
    "interface": "SCSI",
    "source": "kali-arm64-ultra-mini.iso"
  },
  "network": {
    "mode": "shared",
    "hardware": "virtio-net-pci"
  },
  "boot": {
    "bootFrom": "CD/DVD",
    "kernelArguments": "console=ttyAMA0,115200"
  }
}
